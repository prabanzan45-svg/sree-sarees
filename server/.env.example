# ==============================================================================
# Sree Sarees — E-Commerce & Smart Inventory Management System
# Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas URI or local mongod)
# Note: If local MongoDB is not running, the application gracefully operates
# using its built-in persistent JSON store for zero-setup college evaluation.
MONGODB_URI=mongodb://127.0.0.1:27017/sree_sarees

# JWT Authentication Secret Key
JWT_SECRET=sree_sarees_super_secret_jwt_key_2026_tradition_woven_elegance
JWT_EXPIRES_IN=7d

# Initial Administrator / Owner Setup Credentials
ADMIN_NAME=Sree Sarees Owner
ADMIN_EMAIL=owner@sreesarees.com
ADMIN_PASSWORD=OwnerSecure@2026
ADMIN_PHONE=+91 98401 23456

# Payment Gateway Configuration (Razorpay / UPI)
# For evaluation without live merchant keys, the gateway uses standard test mode,
# and direct Google Pay / UPI QR checkout is also available.
PAYMENT_PROVIDER_KEY_ID=rzp_test_sreeSareesKey123
PAYMENT_PROVIDER_KEY_SECRET=rzp_secret_mockSecretForTesting987
PAYMENT_WEBHOOK_SECRET=rzp_whsec_sreeSareesWebhookKey

# Configurable Boutique UPI Details (For Direct QR/UPI mode)
STORE_UPI_ID=sreesarees@upi
STORE_UPI_NAME=Sree Sarees Boutique

# Sree AI Shopping Assistant Configuration (Google Gemini API)
# Optional: Provide a Google Gemini API Key for deep LLM reasoning.
# If omitted or left empty, Sree AI operates via its built-in Intelligent Catalogue Engine.
GEMINI_API_KEY=

# ==============================================================================
# Meta WhatsApp Business Platform API Configuration
# Get credentials from Meta for Developers -> WhatsApp -> API Setup
# ==============================================================================
# 1. WHATSAPP_TOKEN: Meta Cloud API System User Access Token
WHATSAPP_TOKEN=your_meta_system_user_access_token_here

# 2. WHATSAPP_PHONE_NUMBER_ID: Meta Phone Number ID (from WhatsApp App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# 3. WHATSAPP_OWNER_PHONE: Sree Sarees Owner's WhatsApp Number (Country code + digits, e.g. 919840100000)
WHATSAPP_OWNER_PHONE=919840100000

# 4. WHATSAPP_BUSINESS_ACCOUNT_ID: WhatsApp Business Account ID (WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here
